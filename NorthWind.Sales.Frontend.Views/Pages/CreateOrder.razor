@page "/createorder"
@attribute [Authorize]
@using NorthWind.Sales.Frontend.Views.Components
@using NorthWind.RazorComponents.Exceptions
@using NorthWind.Sales.Frontend.Views.Resources

<ErrorBoundary @ref=ErrorBoundaryRef>
    <ChildContent>
        <CreateOrderComponent Order=ViewModel/>
    </ChildContent>
    <ErrorContent>
        <ExceptionDisplay Exception=context />
        <button class="btn btn-danger" @onclick=Recover>
            @CommonMessages.OK
        </button>
    </ErrorContent>
</ErrorBoundary>
