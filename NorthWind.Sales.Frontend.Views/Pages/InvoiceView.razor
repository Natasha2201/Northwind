@page "/invoice/{id:int}"
@attribute [Authorize]
@using System.IO
@using Microsoft.JSInterop
@using NorthWind.Sales.Frontend.BusinessObjects.Interfaces
@using NorthWind.Sales.Frontend.BusinessObjects.ValueObjects
@inject IInvoiceGateway InvoiceGateway
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>Factura</PageTitle>

<div class="p-4">
    @if (Invoice == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="text-muted mt-2">Cargando factura...</p>
        </div>
    }
    else
    {
        <!-- Tarjeta: Encabezado de la Factura -->
        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-body p-4">
                <!-- Encabezado de la Factura -->
                <div class="d-flex justify-content-between align-items-center mb-0 pb-0">
                    <div>
                        <h2 class="fw-bold text-dark m-0">Factura @Invoice.InvoiceNumber</h2>
                        <p class="text-muted m-0 mt-1">@Invoice.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 mb-2">
                            Cliente
                        </span>
                        <h5 class="fw-bold m-0">@Invoice.CustomerName</h5>
                        <p class="text-muted m-0 small">Cédula: @Invoice.CustomerIdentification</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta: Detalle de Productos y Totales -->
        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                                <th class="ps-4 text-muted small fw-semibold">ID</th>
                                <th class="text-muted small fw-semibold">Producto</th>
                                <th class="text-muted small fw-semibold">Precio</th>
                                <th class="text-muted small fw-semibold">Cantidad</th>
                                <th class="text-muted small fw-semibold">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Invoice.Details)
                            {
                                <tr>
                                    <td class="ps-4">@detail.ProductId</td>
                                    <td class="fw-semibold">@detail.ProductName</td>
                                    <td>@detail.UnitPrice.ToString("C")</td>
                                    <td>@detail.Quantity</td>
                                    <td class="fw-semibold text-dark">@detail.Subtotal.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="px-4 pb-4 pt-2">
                    <!-- Contenedor principal de totales y botones -->
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end pt-3 border-top gap-4">

                        <!-- Botones de Acción (Izquierda) -->
                        <div class="d-flex gap-2 order-2 order-md-1">
                            <button class="btn btn-outline-secondary rounded-pill px-4" @onclick="GoBack">
                                Volver
                            </button>
                            <button class="btn btn-success rounded-pill px-4 fw-bold shadow-sm" style="background-color: #10b981; border-color: #10b981;" @onclick="DownloadPdf">
                                <i class="bi bi-file-earmark-pdf me-1"></i> Descargar PDF
                            </button>
                            <button class="btn btn-outline-success rounded-pill px-4 fw-bold" @onclick="PrintPdf">
                                <i class="bi bi-printer me-1"></i> Imprimir
                            </button>
                        </div>

                        <!-- Bloque Unificado de Totales (Derecha) -->
                        <div class="d-flex flex-column align-items-end order-1 order-md-2 ms-auto" style="min-width: 280px;">
                            <div class="w-100 pb-2">
                                <div class="d-flex justify-content-between py-1">
                                    <span class="fw-bold text-dark">Subtotal:</span>
                                    <span class="fw-semibold text-dark">@Invoice.Subtotal.ToString("C")</span>
                                </div>
                                <div class="d-flex justify-content-between py-1">
                                    <span class="fw-bold text-dark">IVA (15%):</span>
                                    <span class="fw-semibold text-dark">@Invoice.Tax.ToString("C")</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-baseline pt-2 mt-1 border-top border-2">
                                    <span class="fs-5 fw-bold text-dark">Total:</span>
                                    <span class="fs-2 fw-bold text-success" style="color: #10b981 !important;">@Invoice.Total.ToString("C")</span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private InvoiceDto? Invoice;

    protected override async Task OnInitializedAsync()
    {
        Invoice = await InvoiceGateway.GetInvoiceAsync(Id);
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/invoices");
    }

    private async Task DownloadPdf()
    {
        try
        {
            var pdfBytes = await InvoiceGateway.GetInvoicePdfAsync(Id);
            var fileName = $"Factura-{Invoice?.InvoiceNumber}.pdf";
            var base64 = Convert.ToBase64String(pdfBytes);
            await JSRuntime.InvokeVoidAsync("downloadPdfFromBase64", fileName, base64);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error al descargar PDF: {ex.Message}");
        }
    }

    private async Task PrintPdf()
    {
        var printWindowId = await JSRuntime.InvokeAsync<string?>("openInvoicePrintWindow");
        if (string.IsNullOrWhiteSpace(printWindowId))
            return;

        try
        {
            if (Invoice is null)
            {
                await JSRuntime.InvokeVoidAsync("closeInvoicePrintWindow", printWindowId);
                return;
            }

            await JSRuntime.InvokeVoidAsync("printInvoiceDocument", printWindowId, Invoice);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("closeInvoicePrintWindow", printWindowId);
            Console.Error.WriteLine($"Error al preparar PDF para imprimir: {ex.Message}");
        }
    }
}
