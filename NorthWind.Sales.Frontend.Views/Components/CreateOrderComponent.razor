@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using NorthWind.RazorComponents.Validators
@using NorthWind.Sales.Frontend.BusinessObjects.ValueObjects
@using NorthWind.Sales.Frontend.Views.ViewModels.CreateOrder
@inject NavigationManager NavigationManager

<div class="p-4">
    <!-- Toast Flotante de Error -->
    @if (!string.IsNullOrEmpty(Order.InformationMessage))
    {
        <div class="position-fixed top-0 end-0 p-3" style="z-index: 1055; margin-top: 60px;">
            <div class="toast show align-items-center @(Order.IsErrorMessage ? "bg-danger text-white" : "") border-0 shadow-lg"
                 role="alert" style="border-radius: 12px; @(!Order.IsErrorMessage ? "background-color: #f8d7da; color: #842029;" : string.Empty)">
                <div class="d-flex align-items-center justify-content-between p-2">
                    <div class="toast-body d-flex align-items-center py-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-exclamation-triangle-fill me-2" viewBox="0 0 16 16">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
                        </svg>
                        <span class="fw-semibold">@Order.InformationMessage</span>
                    </div>
                    <button type="button" class="btn-close @(Order.IsErrorMessage ? "btn-close-white" : "") me-2 m-auto" @onclick="ClearMessage"></button>
                </div>
            </div>
        </div>
    }

    <EditForm Model="Order" OnValidSubmit="SubmitOrder" @ref="FormRef">
        <ModelValidator Validator="Order.Validator" @ref="Order.ModelValidatorComponentReference" />

        <div class="row g-4 align-items-start">
            <div class="col-lg-8">
        <!-- Tarjeta: Datos del Cliente y Envío -->
        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3" style="color: #0f172a;">Nueva Orden de Venta</h4>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Cliente</label>
                        <div class="input-group">
                            <InputText class="form-control"
                                       @bind-Value="Order.CustomerId"
                                       disabled />
                            @if (string.IsNullOrWhiteSpace(Order.CustomerId))
                            {
                                <button type="button" class="btn btn-success"
                                        @onclick="() => ShowCustomerModal = true">
                                    Buscar cliente
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-success rounded flex-shrink-0" @onclick="ConfirmChangeCustomer">
                                    Cambiar cliente
                                </button>
                            }
                        </div>
                        <ValidationMessage For="() => Order.CustomerId" class="text-danger small" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Fecha</label>
                        <InputDate class="form-control"
                                   @bind-Value="Order.OrderDate"
                                   disabled />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold text-muted small">Dirección de Envío</label>
                        <InputText class="form-control bg-light" @bind-Value="Order.ShipAddress" readonly aria-readonly="true" />
                        <ValidationMessage For="() => Order.ShipAddress" class="text-danger small" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted small">Ciudad</label>
                        <input type="text" class="form-control"
                               value="@Order.ShipCity"
                               @oninput="FilterCity"
                               @onblur="() => ValidateField(() => Order.ShipCity)"
                               data-filter="letters"
                               maxlength="15" />
                        <ValidationMessage For="() => Order.ShipCity" class="text-danger small" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted small">País</label>
                        <input type="text" class="form-control"
                               value="@Order.ShipCountry"
                               @oninput="FilterCountry"
                               @onblur="() => ValidateField(() => Order.ShipCountry)"
                               data-filter="letters"
                               maxlength="15" />
                        <ValidationMessage For="() => Order.ShipCountry" class="text-danger small" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted small">Código Postal</label>
                        <input type="text" class="form-control"
                               value="@Order.ShipPostalCode"
                               @oninput="FilterPostalCode"
                               @onblur="() => ValidateField(() => Order.ShipPostalCode)"
                               data-filter="digits"
                               maxlength="6" />
                        <ValidationMessage For="() => Order.ShipPostalCode" class="text-danger small" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta: Productos -->
        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold m-0" style="color: #0f172a;">Productos</h5>
                    <button type="button" class="btn btn-success rounded-pill px-4"
                            @onclick="() => ShowProductModal = true">
                        + Agregar Producto
                    </button>
                </div>

                @if (Order.OrderDetails.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="table-layout: fixed; width: 100%;">
                            <colgroup>
                                <col style="width: 8%;" />
                                <col style="width: 27%;" />
                                <col style="width: 11%;" />
                                <col style="width: 9%;" />
                                <col style="width: 14%;" />
                                <col style="width: 13%;" />
                                <col style="width: 18%;" />
                            </colgroup>
                            <thead>
                                <tr style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                                    <th class="ps-3 text-muted small fw-semibold">ID</th>
                                    <th class="text-muted small fw-semibold">Producto</th>
                                    <th class="text-muted small fw-semibold">Precio</th>
                                    <th class="text-muted small fw-semibold">Stock</th>
                                    <th class="text-muted small fw-semibold">Cantidad</th>
                                    <th class="text-muted small fw-semibold">Subtotal</th>
                                    <th class="text-end pe-3 text-muted small fw-semibold">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Order.OrderDetails)
                                {
                                    <tr>
                                        <td class="ps-3">@item.ProductId</td>
                                        <td class="fw-semibold">@item.ProductName</td>
                                        <td>@item.UnitPrice.ToString("C")</td>
                                        <td><span class="fw-bold text-dark">@item.UnitsInStock</span></td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm"
                                                   value="@item.Quantity"
                                                   @oninput="e => ValidateQuantity(item, e)"
                                                   min="1"
                                                   max="@item.UnitsInStock"
                                                   style="min-width: 110px;"
                                                   step="1" />
                                            @if (item.Quantity < 1)
                                            {
                                                <span class="text-danger small d-block">Mínimo 1</span>
                                            }
                                            @if (item.Quantity > item.UnitsInStock)
                                            {
                                                <span class="text-danger small d-block">Máx. @item.UnitsInStock</span>
                                            }
                                        </td>
                                        <td class="fw-semibold" style="color: #10b981;">
                                            @((item.UnitPrice * item.Quantity).ToString("C"))
                                        </td>
                                        <td class="pe-2">
                                            <div class="d-flex gap-2 justify-content-center">
                                                <button type="button" class="btn btn-outline-success btn-sm rounded px-2" @onclick="() => ConfirmChangeProduct(item)">
                                                    Cambiar
                                                </button>
                                                <button type="button" class="btn btn-outline-danger btn-sm rounded px-2"
                                                        @onclick="() => ConfirmDeleteProduct(item)">
                                                    Eliminar
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <p class="mb-0">No hay productos. Usa el botón "Agregar Producto" para comenzar.</p>
                    </div>
                }
            </div>
        </div>

            </div>
            <div class="col-lg-4">
        <!-- Sección de Totales y Pago (lado a lado) -->
        <div class="d-flex flex-column gap-3 mb-3">
            <!-- Resumen de Pago -->
            <div>
                <div class="card shadow-sm border-0 rounded-4 h-100" style="background-color: #f8fafc;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3" style="color: #0f172a;">Resumen de Pago</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal:</span>
                            <span class="fw-semibold">@Subtotal.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">IVA (15%):</span>
                            <span class="fw-semibold">@Tax.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between border-top pt-3">
                            <span class="fs-5 fw-bold">Total:</span>
                            <span class="fs-5 fw-bold" style="color: #10b981;">@Total.ToString("C")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Efectivo y Cambio -->
            <div>
                <div class="card shadow-sm border-0 rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold" style="color: #0f172a;">Efectivo Recibido:</label>
                            <input type="text" class="form-control form-control-lg text-end cash-input"
                                         value="@CashReceivedText"
                                         @oninput="FilterCashInput"
                                         data-filter="decimal"
                                         inputmode="decimal"
                                         maxlength="30"
                                         aria-label="Efectivo recibido" />
                            @if (CashReceived < 0)
                            {
                                <small class="text-danger mt-1 d-block">El efectivo no puede ser negativo.</small>
                            }
                        </div>
                        <div class="d-flex justify-content-between align-items-center border-top pt-3">
                            <span class="fs-5 fw-bold">Cambio:</span>
                            @if (CashReceived <= 0 || CashReceived < Total)
                            {
                                <span class="fs-4 fw-bold text-muted">$0.00</span>
                            }
                            else
                            {
                                <span class="fs-4 fw-bold text-success">
                                    @Change.ToString("C")
                                </span>
                            }
                        </div>
                        @if (CashReceived > 0 && CashReceived < Total && !Order.OrderDetails.Any(i => i.Quantity > i.UnitsInStock))
                        {
                            <small class="text-danger mt-1 d-block">El efectivo recibido es insuficiente.</small>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Botón Enviar -->
        <div class="d-grid">
            <button type="button"
                    class="btn btn-success btn-lg rounded-pill fw-bold"
                    @onclick="SubmitOrder"
                    disabled="@(!Order.OrderDetails.Any() || Order.OrderDetails.Any(i => i.Quantity > i.UnitsInStock || i.Quantity <= 0) || CashReceived < Total || Total <= 0)">
                Enviar Orden
            </button>
        </div>
            </div>
        </div>
    </EditForm>
</div>

@* Modales *@
@if (ShowCustomerModal)
{
    <CustomerSearchModal OnCustomerSelected="OnCustomerSelected"
                         OnClose="() => ShowCustomerModal = false" />
}

@if (ShowProductModal)
{
    <ProductSearchModal OnProductSelected="OnProductSelected"
                        OnClose="() => ShowProductModal = false"
                        ProductIdsInOrder="@Order.OrderDetails.Select(item => item.ProductId).ToHashSet()" />
}

@if (ShowConfirmModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">@ConfirmTitle</h5>
                    <button type="button" class="btn-close" @onclick="CloseConfirmModal"></button>
                </div>
                <div class="modal-body py-4">
                    @ConfirmMessage
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" @onclick="CloseConfirmModal">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold" @onclick="ExecuteConfirmAction">
                        Aceptar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private EditForm? FormRef;
    private bool ShowCustomerModal = false;
    private bool ShowProductModal = false;

    // Variables para el modal de confirmación
    private bool ShowConfirmModal = false;
    private string ConfirmTitle = "";
    private string ConfirmMessage = "";
    private Action? OnConfirmAction;

    private void OpenConfirmModal(string title, string message, Action onConfirm)
    {
        ConfirmTitle = title;
        ConfirmMessage = message;
        OnConfirmAction = onConfirm;
        ShowConfirmModal = true;
    }

    private void CloseConfirmModal()
    {
        ShowConfirmModal = false;
        OnConfirmAction = null;
    }

    private void ExecuteConfirmAction()
    {
        OnConfirmAction?.Invoke();
        CloseConfirmModal();
    }

    private decimal CashReceived { get; set; } = 0;
    private string CashReceivedText { get; set; } = "0";
    private bool ClearProductsOnNextCustomerSelection;
    private decimal Change => (CashReceived - Total) > 0 ? (CashReceived - Total) : 0;

    private decimal Subtotal => Order?.OrderDetails?.Sum(d => d.UnitPrice * d.Quantity) ?? 0;
    private decimal Tax => Math.Round(Subtotal * 0.15m, 2);
    private decimal Total => Subtotal + Tax;

    private int GetMaxQuantity(CreateOrderDetailViewModel item)
    {
        return item.UnitsInStock;
    }

    private void FilterCashInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        if (value.Length > 30)
        {
            value = value[..30];
        }

        var filtered = new System.Text.StringBuilder(value.Length);
        var decimalPointAdded = false;
        var decimalDigits = 0;

        foreach (var character in value)
        {
            if (char.IsDigit(character))
            {
                if (decimalPointAdded && decimalDigits >= 2)
                {
                    continue;
                }

                filtered.Append(character);
                if (decimalPointAdded)
                {
                    decimalDigits++;
                }
            }
            else if (character == '.' && !decimalPointAdded)
            {
                filtered.Append(character);
                decimalPointAdded = true;
            }
        }

        CashReceivedText = filtered.ToString();

        if (string.IsNullOrEmpty(CashReceivedText))
        {
            CashReceived = 0;
            return;
        }

        if (decimal.TryParse(CashReceivedText, System.Globalization.NumberStyles.AllowDecimalPoint,
                System.Globalization.CultureInfo.InvariantCulture, out var amount))
        {
            CashReceived = Math.Clamp(amount, 0m, 99999.99m);
            if (amount > 99999.99m)
            {
                CashReceivedText = "99999.99";
            }
        }
    }

    private void ConfirmChangeCustomer()
    {
        OpenConfirmModal(
            "Cambiar Cliente",
            "¿Seguro que desea cambiar el cliente? Se perderán los datos de envío actuales.",
            () =>
            {
                Order.CustomerId = string.Empty;
                Order.ShipAddress = string.Empty;
                Order.ShipCity = string.Empty;
                Order.ShipCountry = string.Empty;
                Order.ShipPostalCode = string.Empty;
                ClearProductsOnNextCustomerSelection = true;
                ShowCustomerModal = true;
                StateHasChanged();
            }
        );
    }

    private void ConfirmChangeProduct(CreateOrderDetailViewModel item)
    {
        OpenConfirmModal(
            "Cambiar Producto",
            $"¿Seguro que desea eliminar {item.ProductName} para cambiarlo por otro?",
            () =>
            {
                Order.OrderDetails.Remove(item);
                ShowProductModal = true;
                RecalculateTotals();
                StateHasChanged();
            }
        );
    }

    private void OnCustomerSelected(CustomerSearchDto customer)
    {
        if (ClearProductsOnNextCustomerSelection)
        {
            Order.OrderDetails.Clear();
            CashReceived = 0;
            CashReceivedText = "0";
            ClearProductsOnNextCustomerSelection = false;
            RecalculateTotals();
        }

        Order.CustomerId = customer.Id;
        Order.ShipAddress = customer.FullName;
        Order.InformationMessage = string.Empty;

        if (FormRef?.EditContext != null)
        {
            FormRef.EditContext.NotifyFieldChanged(FieldIdentifier.Create(() => Order.CustomerId));
            FormRef.EditContext.NotifyFieldChanged(FieldIdentifier.Create(() => Order.ShipAddress));
        }
        StateHasChanged();
    }

    private void OnProductSelected(ProductSearchDto product)
    {
        var existing = Order.OrderDetails.FirstOrDefault(d => d.ProductId == product.Id);
        if (existing != null)
        {
            if (existing.Quantity < product.UnitsInStock)
            {
                existing.Quantity += 1;
            }
            else
            {
                SetMessage($"No hay suficiente stock para {product.Name}.", isError: true);
            }
        }
        else
        {
            Order.OrderDetails.Add(new CreateOrderDetailViewModel
            {
                ProductId = product.Id,
                ProductName = product.Name,
                UnitPrice = product.UnitPrice,
                Quantity = 1,
                UnitsInStock = product.UnitsInStock
            });
            ClearMessage();
        }
        RecalculateTotals();
    }

    private void ValidateQuantity(CreateOrderDetailViewModel item)
    {
        if (item.Quantity <= 0)
        {
            item.Quantity = 1;
        }
        RecalculateTotals();
    }

    private void ValidateQuantity(CreateOrderDetailViewModel item, ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var quantity))
        {
            return;
        }

        if (quantity > item.UnitsInStock)
        {
            item.Quantity = item.UnitsInStock;
            SetMessage($"La cantidad máxima para {item.ProductName} es {item.UnitsInStock}. Se ha ajustado automáticamente.", isError: false);
        }
        else if (quantity < 0)
        {
            item.Quantity = 0;
        }
        else
        {
            item.Quantity = (short)quantity;
        }

        RecalculateTotals();
    }

    private void ConfirmDeleteProduct(CreateOrderDetailViewModel item)
    {
        OpenConfirmModal(
            "Confirmar eliminación",
            $"¿Eliminar {item.ProductName} de la orden?",
            () =>
            {
                Order.RemoveDetail(item.ProductId);
                RecalculateTotals();
                StateHasChanged();
            }
        );
    }

    private void ValidateField<TProperty>(System.Linq.Expressions.Expression<Func<TProperty>> accessor)
    {
        if (FormRef?.EditContext != null)
        {
            FormRef.EditContext.NotifyFieldChanged(FieldIdentifier.Create(accessor));
        }
    }

    private void FilterLetters(ChangeEventArgs e) => _ = FilterCity(e);
    private async Task FilterCity(ChangeEventArgs e)
    {
        Order.InformationMessage = string.Empty;
        var raw = e.Value?.ToString() ?? string.Empty;
        var filtered = new string(raw.Where(c => char.IsLetter(c) || char.IsWhiteSpace(c)).Take(15).ToArray());
        if (raw != filtered)
        {
            Order.ShipCity = string.Empty;
            StateHasChanged();
            await Task.Yield();
        }
        Order.ShipCity = filtered;
        ValidateField(() => Order.ShipCity);
    }

    private async Task FilterCountry(ChangeEventArgs e)
    {
        Order.InformationMessage = string.Empty;
        var raw = e.Value?.ToString() ?? string.Empty;
        var filtered = new string(raw.Where(c => char.IsLetter(c) || char.IsWhiteSpace(c)).Take(15).ToArray());
        if (raw != filtered)
        {
            Order.ShipCountry = string.Empty;
            StateHasChanged();
            await Task.Yield();
        }
        Order.ShipCountry = filtered;
        ValidateField(() => Order.ShipCountry);
    }

    private void FilterNumbers(ChangeEventArgs e) => _ = FilterPostalCode(e);
    private async Task FilterPostalCode(ChangeEventArgs e)
    {
        Order.InformationMessage = string.Empty;
        var raw = e.Value?.ToString() ?? string.Empty;
        var filtered = new string(raw.Where(char.IsDigit).Take(6).ToArray());
        if (raw != filtered)
        {
            Order.ShipPostalCode = string.Empty;
            StateHasChanged();
            await Task.Yield();
        }
        Order.ShipPostalCode = filtered;
        ValidateField(() => Order.ShipPostalCode);
    }

    private System.Threading.CancellationTokenSource? messageCts;

    protected override void OnInitialized()
    {
        ClearMessage();
    }

    private void ClearMessage()
    {
        messageCts?.Cancel();
        Order.InformationMessage = string.Empty;
    }

    private void SetMessage(string message, bool isError = true)
    {
        Order.InformationMessage = message;
        Order.IsErrorMessage = isError;
        StartAutoDismiss();
    }

    private void StartAutoDismiss()
    {
        messageCts?.Cancel();
        messageCts?.Dispose();
        messageCts = new System.Threading.CancellationTokenSource();
        var token = messageCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(4000, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(() =>
                    {
                        Order.InformationMessage = string.Empty;
                        StateHasChanged();
                    });
                }
            }
            catch (TaskCanceledException) { }
        });
    }

    private async Task SubmitOrder()
    {
        ClearMessage();

        if (string.IsNullOrWhiteSpace(Order.CustomerId))
        {
            SetMessage("Debe seleccionar un cliente.", isError: true);
            ValidateField(() => Order.CustomerId);
            return;
        }
        if (string.IsNullOrWhiteSpace(Order.ShipAddress))
        {
            SetMessage("Debe proporcionar la dirección de envío.", isError: true);
            ValidateField(() => Order.ShipAddress);
            return;
        }
        if (string.IsNullOrWhiteSpace(Order.ShipCity) || Order.ShipCity.Trim().Length < 3)
        {
            SetMessage("La ciudad es requerida (mínimo 3 caracteres).", isError: true);
            ValidateField(() => Order.ShipCity);
            return;
        }
        if (string.IsNullOrWhiteSpace(Order.ShipCountry) || Order.ShipCountry.Trim().Length < 3)
        {
            SetMessage("El país es requerido (mínimo 3 caracteres).", isError: true);
            ValidateField(() => Order.ShipCountry);
            return;
        }
        if (string.IsNullOrWhiteSpace(Order.ShipPostalCode))
        {
            SetMessage("El código postal es requerido.", isError: true);
            ValidateField(() => Order.ShipPostalCode);
            return;
        }
        if (!Order.OrderDetails.Any())
        {
            SetMessage("Debe agregar al menos un producto.", isError: true);
            return;
        }
        if (Order.OrderDetails.Any(i => i.Quantity > i.UnitsInStock))
        {
            SetMessage("Hay productos cuya cantidad excede el stock disponible.", isError: true);
            return;
        }
        if (Order.OrderDetails.Any(i => i.Quantity <= 0))
        {
            SetMessage("La cantidad ordenada debe ser al menos 1.", isError: true);
            return;
        }
        if (CashReceived < 0)
        {
            SetMessage("El efectivo recibido no puede ser negativo.", isError: true);
            return;
        }
        if (CashReceived < Total)
        {
            SetMessage("El efectivo recibido es insuficiente.", isError: true);
            return;
        }

        await Order.Send();

        if (Order.LastCreatedOrderId > 0)
        {
            var invoiceId = Order.LastCreatedOrderId;
            CashReceived = 0;
            ClearMessage();
            NavigationManager.NavigateTo($"/invoice/{invoiceId}");
        }
        else if (!string.IsNullOrEmpty(Order.InformationMessage))
        {
            Order.IsErrorMessage = true;
            StartAutoDismiss();
        }
    }

    private void RecalculateTotals()
    {
        StateHasChanged();
    }
}
